    },
    "landedCost": {
      "route": "toolkit/landed-cost",
      "successEvidence": "All user-entered assumptions and the authorized source price are present and a finite landed-cost result is produced."
    },
    "alerts": {
      "route": "toolkit/alerts",
      "successEvidence": "A rule is saved and one credit is consumed only after a matching event is successfully delivered in app or as a notification."
